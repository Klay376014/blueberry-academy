/**
 * Deploy config for the Worker built by Nitro's `cloudflare_module` preset
 * (docs/adr/0002-cloudflare-module-preset.md). Both paths below are build
 * outputs, so `nuxt build` has to have run first — scripts/deploy.sh chains the
 * two, and passes the NUXT_PUBLIC_* values that are deliberately not here
 * (docs/adr/0011-nuxt-public-as-worker-runtime-vars.md).
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueberry-academy",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-18",

  // Answers the WARN that ADR-0002 left open, and is safe to answer this way
  // only because this file is hand-maintained; see that ADR's #48 note.
  "compatibility_flags": ["nodejs_compat"],

  // ASSETS is the binding name the preset's server entry fetches through; it is
  // not a free choice.
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },

  // `custom_domain` needs the zone in the same Cloudflare account; wrangler then
  // creates the DNS record itself. Changing this origin means changing
  // supabase/config.toml's `site_url` and `additional_redirect_urls` with it --
  // redirectTo is built from window.location.origin, so an unlisted origin
  // cannot sign in. scripts/deploy.sh reads the pattern back out of this file.
  "routes": [
    {
      "pattern": "blueberry-academy.ivy-cudgel.com",
      "custom_domain": true,
    },
  ],

  "observability": {
    "enabled": true,
  },
}
