{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-conventions.sh\"",
            "timeout": 15,
            "statusMessage": "Checking AGENTS.md 實作守則..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-file.sh\"",
            "timeout": 120,
            "statusMessage": "vp check --fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-stop.sh\"",
            "timeout": 300,
            "statusMessage": "vp run -r test:unit + type-check"
          }
        ]
      }
    ]
  }
}
